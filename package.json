{
  "name": "web-pulse",
  "version": "0.1.0",
  "description": "Connect AI Agents to the Web. Typed SDK, CLI and MCP tools for public web access.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muhil-kannan/web-pulse.git"
  },
  "homepage": "https://github.com/Muhil-kannan/web-pulse#readme",
  "bugs": {
    "url": "https://github.com/Muhil-kannan/web-pulse/issues"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp/server.d.ts",
        "default": "./dist/mcp/server.js"
      },
      "require": {
        "types": "./dist/mcp/server.d.cts",
        "default": "./dist/mcp/server.cjs"
      }
    }
  },
  "bin": {
    "webpulse": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "examples",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "web",
    "cli",
    "typescript"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "node scripts/live-smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "release:verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm pack --dry-run && npm run test:package"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.11.2",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4",
    "undici": "^6.29.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
